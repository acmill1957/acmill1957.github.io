---
import type { Link } from '../data/profile';
interface Props {
  name: string;
  title: string;
  summary: string;
  email: string;
  phone: string;
  photo: string;
  ctas: Link[];
}
const { name, title, summary, email, phone, photo, ctas } = Astro.props;
---
<section id="top" aria-labelledby="hero-title" class="bg-ink text-white">
  <div class="site-container flex flex-wrap items-center gap-14 pb-[104px] pt-24">
    <div class="flex min-w-0 flex-[999_1_520px] flex-col gap-6">
      <div class="font-mono text-[13px] uppercase tracking-[0.08em] text-[#EE526B]">{title}</div>
      <h1 id="hero-title" class="font-heading text-[clamp(48px,7vw,88px)] font-bold leading-[0.95] tracking-[-0.03em]">{name}</h1>
      <p class="max-w-[560px] text-[19px] leading-[1.55] text-[#C9C9C9]">{summary}</p>
      <div class="mt-2 flex flex-wrap gap-3">
        {ctas.map((cta, i) => {
          const style = i === 0
            ? 'rounded-md bg-accent px-[22px] py-[14px] text-[15px] font-semibold text-white hover:bg-[#A60D26]'
            : 'rounded-md border border-[#444444] px-[22px] py-[13px] text-[15px] font-medium text-white';
          return cta.href ? <a href={cta.href} class={style}>{cta.label}</a> : <span class={style}>{cta.label}</span>;
        })}
      </div>
      <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[13px] text-[#9A9A9A]">
        <a class="break-all hover:text-white" href={`mailto:${email}`}>{email}</a>
        <a class="hover:text-white" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a>
      </div>
    </div>
    <div class="flex min-w-0 flex-[1_1_280px] justify-center">
      <div class="relative aspect-[5/6] w-[300px] max-w-[calc(100%-20px)]">
        <div aria-hidden="true" class="absolute inset-0 translate-x-[18px] translate-y-[18px] rounded-lg border-2 border-accent"></div>
        <img src={`${import.meta.env.BASE_URL}${photo}`} alt={`Portrait of ${name}`} width="300" height="360" fetchpriority="high" class="relative h-full w-full rounded-lg bg-[#2A2A2A] object-cover" />
      </div>
    </div>
  </div>
</section>
