---
import Tag from './Tag.astro';
import type { Experience } from '../data/experience';
interface Props extends Experience {}
const { role, company, logo, dates, bullets, tags } = Astro.props;
---
<article class="card flex flex-col gap-6 p-8">
  <div class="flex flex-wrap items-center gap-5">
    <img src={`${import.meta.env.BASE_URL}${logo}`} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded-[10px] bg-[#EFEDE8] object-contain" />
    <div class="flex min-w-0 flex-[1_1_240px] flex-col gap-1">
      <h3 class="font-heading text-[22px] font-semibold">{role}</h3>
      <div class="text-base text-muted">{company}</div>
    </div>
    <div class="date-label">{dates}</div>
  </div>
  <ul class="flex list-disc flex-col gap-3 pl-5 text-base leading-[1.6] text-[#333333]">
    {bullets.map(bullet => <li>{bullet}</li>)}
  </ul>
  <div class="flex flex-wrap gap-2">{tags.map(tag => <Tag>{tag}</Tag>)}</div>
</article>
