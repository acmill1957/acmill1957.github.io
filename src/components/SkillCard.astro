---
import type { Skill } from '../data/skills';
interface Props extends Skill {}
const { title, icon, items } = Astro.props;
---
<article class="card flex flex-col gap-4 p-7">
  <div class="flex items-center gap-3">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-accent">
      {icon === 'code' && <><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></>}
      {icon === 'coffee' && <><path d="M17 8h1a4 4 0 1 1 0 8h-1" /><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" /><path d="M6 2v2M10 2v2M14 2v2" /></>}
      {icon === 'database' && <><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" /><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" /></>}
      {icon === 'monitor' && <><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></>}
    </svg>
    <h3 class="font-heading text-xl font-semibold">{title}</h3>
  </div>
  <ul class="flex list-disc flex-col gap-2 pl-[18px] text-[15px] leading-[1.55] text-[#444444]">
    {items.map(item => <li>{item}</li>)}
  </ul>
</article>
